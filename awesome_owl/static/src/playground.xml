<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="awesome_owl.playground">
        <div class="card p-3 d-inline-block" style="min-width: 18rem;">
            <div class="card p-3 d-inline-block">
            <div class="d-flex align-items-center justify-content-between">
                <!-- متن Hello World در سمت چپ -->
                <span class="ms-3">hello world</span>
                <div class="d-flex align-items-center gap-3">
                    <Counter onChange.bind="incrementSum"/>
                    <Counter onChange.bind="incrementSum"/>
                </div>

            </div>
                <p><h6>The sum is: <t t-esc="state.sum"/></h6></p>
            </div>
            <div class="d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center justify-content-between">
                    <Card title="'card 1'" content="escapedContent"/>
                    <Card title="'card 2'" content="renderedContent"/>

                </div>
            </div>
            <div class="card d-inline-block m-2" style="width: 18rem;">
            <div class="card-body p-2 border rounded">
                <TodoList/>
            </div>
            </div>
        </div>
    </t>
</templates>