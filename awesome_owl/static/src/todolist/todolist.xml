<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="awesome_owl.todoitem" owl="1">
         <div class="d-flex align-items-center p-2 border-bottom">
             <button
                    type="button"
                    class="btn btn-sm btn-outline-danger"
                    t-on-click="onRemove"
            >
                    <i class="fa fa-trash"></i>
                 </button>
             <input
                     type="checkbox"
                     class="form-check-input me-2"
                     t-att-checked="props.todo.isCompleted"
                     t-on-change="onToggle"
             />
             <span t-att-class="props.todo.isCompleted ? 'text-muted text-decoration-line-through' : ''">
            <t t-esc="props.todo.id"/>.
                 <t t-esc="props.todo.description"/>
            </span>
        </div>
    </t>

    <t t-name="awesome_owl.todolist" owl="1">
        <div>
            <input type="text"
                   t-ref="input"
                   class="form-control mb-2"
                   placeholder="Add a todo"
                   t-on-keyup="addTodo"/>
            <t t-foreach="todos" t-as="todo" t-key="todo.id">
                    <TodoItem todo="todo" toggleState.bind="toggleTodo" removeTodo.bind="removeTodo"/>
            </t>
        </div>
        </t>
</templates>